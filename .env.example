# =========================================================================
# HanziGo Environment Configuration (.env)
# =========================================================================
# LƯU Ý BẢO MẬT:
# 1. KHÔNG commit file .env chứa giá trị thật lên Git/GitHub.
# 2. KHÔNG đưa Supabase `service_role` key vào frontend (chỉ dùng `anon` key cho VITE_SUPABASE_ANON_KEY).
# 3. Biến nhạy cảm (GEMINI_API_KEY) KHÔNG có tiền tố VITE_ để tránh lộ vào client bundle.
#    Nó chỉ được đọc bởi Vercel Serverless Function (/api/ai/chat) hoặc Vite dev server middleware.
# 4. Khi deploy lên Vercel: Vào Project Settings > Environment Variables để cấu hình.

# Supabase API Credentials
# [BẮT BUỘC cho Frontend]: Dùng `anon` key công khai, KHÔNG BAO GIỜ đưa `service_role` key ra Frontend
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [BẮT BUỘC cho Backend Serverless `/api/*`]: Supabase Admin Client (TUYỆT ĐỐI KHÔNG dùng tiền tố VITE_)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Backend / Serverless Secret (Bảo mật tuyệt đối, không lộ ra client)
# =========================================================================
# AI Personalization Engine (Google Gemini + Offline Deterministic Fallback)
# =========================================================================
# Google Gemini API Key [TÙY CHỌN - Có Offline Deterministic Fallback nếu chưa cấu hình]
# (Server-side ONLY, KHÔNG dùng tiền tố VITE_)
GEMINI_API_KEY=your_gemini_api_key_here
# Danh sách nhiều API Key (ngăn cách bởi dấu phẩy) để tự động xoay vòng khi key chính hết hạn mức (429/403)
GEMINI_API_KEYS=your_backup_gemini_key_1,your_backup_gemini_key_2
GEMINI_MODEL=gemini-3.5-flash-lite
# [TÙY CHỌN - Tier-2 OpenAI-Compatible Fallback]: Groq (ưu tiên 2) & OpenRouter (ưu tiên 3)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2
OPENROUTER_API_KEY=your_openrouter_api_key_here
# [TÙY CHỌN - Có Fallback]: OpenAI API Key dự phòng cho AI / TTS
OPENAI_API_KEY=your_openai_api_key_here

# Feature Flag & Emergency Kill Switch (Bật / Tắt nhanh Gia sư AI trên production)
ENABLE_AI_TUTOR=true
AI_TUTOR_KILL_SWITCH=false
VITE_ENABLE_AI_TUTOR=true

# =========================================================================
# WebRTC TURN / STUN Configuration (Live Classroom NAT & Firewall Traversal)
# =========================================================================
# KHUYẾN NGHỊ SẢN XUẤT (BẢO MẬT CAO - EPHEMERAL TURN REST API) [TÙY CHỌN - Mặc định dùng Google STUN]:
# Cấu hình TURN_SERVER_URL (hoặc alias COTURN_SERVER_URL) và TURN_SHARED_SECRET ở Backend/Serverless (KHÔNG có tiền tố VITE_).
# Endpoint `/api/webrtc/ice-servers` sẽ tự động sinh ephemeral username/HMAC credential có thời hạn 1 giờ
# cho học viên và giáo viên đã đăng nhập, bảo vệ tuyệt đối không làm lộ mật khẩu TURN vĩnh viễn trong frontend bundle.
TURN_SERVER_URL=turn.your-domain.com:3478
COTURN_SERVER_URL=turn.your-domain.com:3478
TURN_SHARED_SECRET=your_coturn_static_auth_secret_here

# Tùy chọn kiểm thử cục bộ (Không khuyến nghị dùng credential dài hạn trên production):
# VITE_TURN_SERVER_URL=turn:turn.your-domain.com:3478
# VITE_TURN_USERNAME=your_turn_username
# VITE_TURN_CREDENTIAL=your_turn_credential
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# =========================================================================
# Distributed Rate Limiting & Quota (Upstash Redis for Serverless)
# =========================================================================
# [TÙY CHỌN - Có In-Memory Fallback]: Kết nối Upstash Redis REST để lưu trữ Rate Limit & Quota bền vững giữa các serverless invocations.
# Đặt ALLOW_IN_MEMORY_RATE_LIMIT=true nếu chạy Production quy mô nhỏ không dùng Redis (tránh fail-closed 503).
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
ALLOW_IN_MEMORY_RATE_LIMIT=true

# =========================================================================
# LiveKit WebRTC SFU (Live Classroom Video, Audio & Screen Sharing)
# =========================================================================
# Đăng ký miễn phí tại https://cloud.livekit.io hoặc dùng Self-hosted LiveKit Server
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# =========================================================================
# Azure Cognitive Services Speech (Neural TTS Caching Proxy)
# =========================================================================
# [TÙY CHỌN - Có Fallback Web Speech API]:
# Serverless secret keys for Neural TTS (/api/audio/tts).
# Tuyệt đối KHÔNG có tiền tố VITE_ để không lộ ra Client.
# Hỗ trợ giọng Xiaoxiao (zh-CN-XiaoxiaoNeural) và Yunxi (zh-CN-YunxiNeural).
# Tự động cache âm thanh SHA-256 trên Supabase Storage bucket 'audio-cache'.
# Nếu thiếu key hoặc quota lỗi, hệ thống tự động fallback an toàn sang Web Speech API.
AZURE_SPEECH_KEY=your_azure_speech_resource_key_here
AZURE_SPEECH_REGION=eastasia
# [TÙY CHỌN]: Endpoint Edge TTS proxy tùy chỉnh
EDGE_TTS_ENDPOINT=

