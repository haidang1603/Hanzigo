# =========================================================================
# HanziGo Environment Configuration (.env)
# =========================================================================
# LƯU Ý BẢO MẬT:
# 1. KHÔNG commit file .env chứa giá trị thật lên Git/GitHub.
# 2. KHÔNG đưa Supabase `service_role` key vào frontend (chỉ dùng `anon` key cho VITE_SUPABASE_ANON_KEY).
# 3. Biến nhạy cảm (GEMINI_API_KEY) KHÔNG có tiền tố VITE_ để tránh lộ vào client bundle.
#    Nó chỉ được đọc bởi Vercel Serverless Function (/api/ai/chat) hoặc Vite dev server middleware.
# 4. Khi deploy lên Vercel: Vào Project Settings > Environment Variables để cấu hình.

# Supabase API Credentials (Frontend an toàn với anon key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend / Serverless Secret (Bảo mật tuyệt đối, không lộ ra client)
# Dùng cho Vercel Serverless Function (/api/ai/chat) và Vite dev server
GEMINI_API_KEY=your_gemini_api_key_here

# =========================================================================
# WebRTC TURN / STUN Configuration (Live Classroom NAT & Firewall Traversal)
# =========================================================================
# Tùy chọn: TURN Relay server để học viên/giáo viên vượt tường lửa NAT đối xứng
VITE_TURN_SERVER_URL=turn:turn.your-domain.com:3478
VITE_TURN_USERNAME=your_turn_username
VITE_TURN_CREDENTIAL=your_turn_credential
# Hoặc JSON cấu hình mảng ICE Servers đầy đủ
# VITE_WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.domain.com:3478","username":"user","credential":"pwd"}]

# =========================================================================
# Distributed Rate Limiting & Quota (Upstash Redis for Serverless)
# =========================================================================
# Tùy chọn: Kết nối Upstash Redis REST để lưu trữ Rate Limit & Quota bền vững giữa các serverless invocations.
# Nếu không cung cấp, hệ thống tự động fallback an toàn sang In-Memory Rate Limiter.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

