# =========================================================================
# HanziGo Environment Configuration (.env)
# =========================================================================
# LƯU Ý BẢO MẬT:
# 1. KHÔNG commit file .env chứa giá trị thật lên Git/GitHub.
# 2. KHÔNG đưa Supabase `service_role` key vào frontend (chỉ dùng `anon` key cho VITE_SUPABASE_ANON_KEY).
# 3. Biến nhạy cảm (GEMINI_API_KEY) KHÔNG có tiền tố VITE_ để tránh lộ vào client bundle.
#    Nó chỉ được đọc bởi Vercel Serverless Function (/api/ai/chat) hoặc Vite dev server middleware.
# 4. Khi deploy lên Vercel: Vào Project Settings > Environment Variables để cấu hình.

# Supabase API Credentials (Frontend an toàn với anon key)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend / Serverless Secret (Bảo mật tuyệt đối, không lộ ra client)
# Dùng cho Vercel Serverless Function (/api/ai/chat) và Vite dev server
GEMINI_API_KEY=your_gemini_api_key_here
