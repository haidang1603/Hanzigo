# =========================================================================
# HanziGo Environment Configuration (.env)
# =========================================================================
# LƯU Ý BẢO MẬT:
# 1. KHÔNG commit file .env chứa giá trị thật lên Git/GitHub.
# 2. KHÔNG đưa Supabase `service_role` key vào frontend (chỉ dùng `anon` key).
# 3. Khi deploy lên Vercel: Vào Project Settings > Environment Variables để nhập các biến này.

# Supabase API Credentials (Lấy tại https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Tùy chọn: AI Tutor Integration (Gemini / OpenAI API Key cho tính năng AI Conversation nâng cao)
# Nếu không cung cấp, hệ thống tự động chạy chế độ Simulated AI Tutor an toàn
VITE_GEMINI_API_KEY=
VITE_OPENAI_API_KEY=
