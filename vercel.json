{
  "rewrites": [
    {
      "source": "/api/ai/:action",
      "destination": "/api/ai/[action]?action=:action"
    },
    {
      "source": "/api/classroom/:action",
      "destination": "/api/classroom/[action]?action=:action"
    },
    {
      "source": "/api/live/:action",
      "destination": "/api/live/[action]?action=:action"
    },
    {
      "source": "/api/hsk/:action",
      "destination": "/api/hsk/[action]?action=:action"
    },
    {
      "source": "/api/webrtc/:action",
      "destination": "/api/webrtc/[action]?action=:action"
    },
    {
      "source": "/api/newsletter/:action",
      "destination": "/api/newsletter/[action]?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
