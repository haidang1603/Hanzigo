{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://www.hanzigo.io.vn https://*.googleusercontent.com; media-src 'self' data: blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.livekit.cloud wss://*.livekit.cloud https://cdn.jsdelivr.net https://accounts.google.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/ai/:action",
      "destination": "/api/ai/[action]?action=:action"
    },
    {
      "source": "/api/classroom/:action",
      "destination": "/api/classroom/[action]?action=:action"
    },
    {
      "source": "/api/live/:action",
      "destination": "/api/live/[action]?action=:action"
    },
    {
      "source": "/api/hsk/:action",
      "destination": "/api/hsk/[action]?action=:action"
    },
    {
      "source": "/api/webrtc/:action",
      "destination": "/api/webrtc/[action]?action=:action"
    },
    {
      "source": "/api/newsletter/:action",
      "destination": "/api/newsletter/[action]?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|manifest\\.webmanifest$|sw\\.js$|robots\\.txt$|sitemap\\.xml$).*)",
      "destination": "/index.html"
    }
  ]
}
